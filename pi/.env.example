# Copy to .env and fill in. Create an app at:
#   https://trakt.tv/oauth/applications/new   (redirect URI: urn:ietf:wg:oauth:2.0:oob)
TRAKT_CLIENT_ID=your_client_id
TRAKT_CLIENT_SECRET=your_client_secret

# Port the interface is served on (Chromium kiosk points here).
PORT=8730

# Where OAuth tokens are cached on the Pi (keep off any synced/backed-up dir).
# TRAKT_TOKENS_PATH=/home/pi/.config/trakt-pi/tokens.json

# Command used to open a streaming web player from the "Ways to watch" panel.
# Default xdg-open launches the Pi's default browser. On a single kiosk window
# you may prefer to leave this and let the UI navigate instead (see README).
# WATCH_OPEN_CMD=xdg-open

# --- GIF Stream (Reddit) ---
# The "GIF Stream" screen plays animated posts from Reddit as a lean-back channel.
# It uses Reddit's public read-only listing JSON — no account or API key needed.
# Subreddits to pull from ("+"-joined). Override to make your own channel.
# GIF_SUBS=gifs+perfectloops+oddlysatisfying+aww+reactiongifs+AnimalsBeingDerps+nextfuckinglevel+BetterEveryLoop
# Reddit asks clients to send a descriptive User-Agent; change if you like.
# REDDIT_USER_AGENT=trakt-pi/0.1 (gif-stream)
