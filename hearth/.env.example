# Copy to .env and adjust. All optional — Hearth runs with defaults and you can
# add calendars from the on-screen Settings instead of here.

PORT=8080

# Weather (Open-Meteo, no API key needed). Set your location + units.
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
WEATHER_UNIT=fahrenheit        # fahrenheit | celsius

# How often to re-fetch calendar feeds, in minutes.
REFRESH_MINUTES=15

# Optional: seed calendar feeds on first run (otherwise add them in Settings).
# JSON array of { name, color, url }. Each url is a secret .ics link exported
# from Google/iCloud/Outlook/Cozi/any calendar.
# HEARTH_FEEDS=[{"name":"Mom","color":"#e5484d","url":"https://.../basic.ics"},{"name":"Kids","color":"#2f80ed","url":"https://.../kids.ics"}]

# Optional: Home Assistant bridge — lets the phone remote (/remote) control your
# lights, Xbox, media, etc. Create a long-lived access token in HA (Profile →
# Security). HA_BUTTONS is a JSON array of { label, service, entity, icon }.
# Xbox needs the HA "Xbox" integration; set the console power mode to Sleep for
# remote power-on. Lights/most devices in HA work here regardless of Alexa.
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=your_long_lived_token
# HA_BUTTONS=[{"label":"Living room","icon":"💡","service":"light.toggle","entity":"light.living_room"},{"label":"Xbox On","icon":"🎮","service":"media_player.turn_on","entity":"media_player.xbox"},{"label":"Xbox Off","icon":"⏻","service":"media_player.turn_off","entity":"media_player.xbox"}]
