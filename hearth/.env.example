# Copy to .env and adjust. All optional — Hearth runs with defaults and you can
# add calendars from the on-screen Settings instead of here.

PORT=8080

# Weather (Open-Meteo, no API key needed). Set your location + units.
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
WEATHER_UNIT=fahrenheit        # fahrenheit | celsius

# How often to re-fetch calendar feeds, in minutes.
REFRESH_MINUTES=15

# Optional: seed calendar feeds on first run (otherwise add them in Settings).
# JSON array of { name, color, url }. Each url is a secret .ics link exported
# from Google/iCloud/Outlook/Cozi/any calendar.
# HEARTH_FEEDS=[{"name":"Mom","color":"#e5484d","url":"https://.../basic.ics"},{"name":"Kids","color":"#2f80ed","url":"https://.../kids.ics"}]
